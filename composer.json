{
	"name": "xchert/encapsulation",
	"description": "A library for data encapsulation and collections",
	"keywords": [
		"encapsulation",
		"data objects",
		"collections",
		"container",
		"properties",
		"immutability"
	],
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Dustin Simon"
		}
	],
	"support": {
		"issues": "https://github.com/x-chert/encapsulation/issues",
		"source": "https://github.com/x-chert/encapsulation"
	},
	"autoload": {
		"psr-4": {
			"Xchert\\Encapsulation\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Xchert\\Encapsulation\\Test\\": "tests/"
		}
	},
	"require": {
		"php": "^8.4",
		"xchert/util": "^1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.3.1"
	},
	"archive": {
		"exclude": [
			"/.github"
		]
	}
}
