{
	"name": "xchert/encapsulation",
	"description": "A library for data encapsulation and collections",
	"keywords": [
		"encapsulation",
		"data objects",
		"collections",
		"container",
		"properties",
		"immutability"
	],
	"type": "library",
	"license": "MIT",
	"authors": [{
		"name": "Dustin Simon"
	}],
	"support": {
		"issues": "https://github.com/x-chert/encapsulation/issues",
		"source": "https://github.com/x-chert/encapsulation"
	},
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Xchert\\Encapsulation\\": "src/"
		}
	},
	"require": {
		"php": "^8.2",
		"xchert/util": "~1.0.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.2"
	}
}
